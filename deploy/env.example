# ~/naklearn/.env auf torte (chmod 600).
# Werte in EINFACHE Anführungszeichen setzen: ohne sie (oder mit "…") macht Compose aus
# einem $ im Passwort still etwas anderes, und der Login klappt nie.
NAKLEARN_PASSWORD=''
# am Laptop: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=''
# optional, Standard sonnet/opus
#NAKLEARN_SUMMARY_MODEL='sonnet'
#NAKLEARN_CARDS_MODEL='opus'
