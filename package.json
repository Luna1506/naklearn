{
  "name": "naklearn",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --test scripts/release.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev:server": "npm run dev -w @naklearn/server",
    "dev:client": "npm run dev -w @naklearn/client",
    "build": "npm run build -w @naklearn/client",
    "android:build": "npm run android:build -w @naklearn/client",
    "android:install": "npm run android:install -w @naklearn/client",
    "release": "node scripts/release.ts",
    "release:key": "node scripts/release.ts key"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
